# Copy to .env.local and fill in. Keys are read only in server routes (process.env).
GEMINI_API_KEY=
# Optional: tried first; falls back to gemini-3.6-flash, 3.5-flash, 3.1-flash-lite
GEMINI_MODEL=
# Optional: enables Whisper voice transcription. Without it the app uses browser speech recognition.
GROQ_API_KEY=
